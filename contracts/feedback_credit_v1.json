{
  "contract": "feedback_credit_v1",
  "scenario": 4,
  "title": "화용 피드백 · 이중 센터링 크레딧 & 무손실 동기화",
  "roadmap": "M0 · M3",
  "source": "최종개선안: raon-zena 와 premium-discount 시나리오별 개선 개발 기획안 (24개 Part, 72개 검증 벡터)",
  "params": {
    "idempotent_window_ms": 5000,
    "request_id_prefix": "idemp-",
    "request_id_len": 54,
    "max_server_attempts": 5,
    "max_pending_items": 1000,
    "max_tracking_items": 2000,
    "retain_ms": 604800000,
    "max_queued_votes": 2000,
    "default_retry_after_ms": 60000,
    "max_unacked_rejections": 32,
