      "owners": [
        {
          "repo": "raon-zena",
          "path": "crates/zena-verdict/src",
          "test": "fc01_"
        },
        {
          "repo": "premium-discount",
          "path": "crates/premium-discount-nms/src",
          "test": "fc01_"
        }
      ]
    },
    {
      "id": "FC-02",
      "part": 1,
      "title": "역접 복합문 주절 우선",
