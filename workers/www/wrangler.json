{
	"compatibility_date": "2026-04-01",
	"main": "build/index.js",
	"build": {
		"command": "cargo install -q worker-build@0.8.7 --locked && worker-build --release"
	},
	"name": "premium-discount",
	"d1_databases": [
		{
			"binding": "apac1_premium_discount",
			"database_id": "a8a16911-35a1-4dca-9b4c-95fbe82a7da1",
			"database_name": "apac1_premium_discount"
		},
		{
			"binding": "DB",
			"database_id": "f7ec6d8c-4274-44e7-94e9-d25410026f4b",
			"database_name": "premium_discount",
			"migrations_dir": "../migrations"
		}
	],
	"vectorize": [
		{
			"binding": "EVAL_VECTORIZE",
			"index_name": "premium-discount-eval"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"SESSION_MAIL_HOST": "premium.discount"
	},
	"ratelimits": [
		{
			"name": "EVAL_WRITE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "EVAL_READ_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "ANALYTIC_WRITE_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"assets": {
		"directory": "../../web/www/",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "CDN",
			"bucket_name": "cdn"
		}
	]
}
